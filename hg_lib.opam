opam-version: "2.0"
maintainer: "Jane Street developers"
authors: ["Jane Street Group, LLC"]
homepage: "https://github.com/public-release-reloaded/hg_lib"
bug-reports: "https://github.com/public-release-reloaded/hg_lib/issues"
dev-repo: "git+https://github.com/public-release-reloaded/hg_lib.git#v0.18_preview.130.100+614+reloaded"
doc: "https://ocaml.janestreet.com/ocaml-core/latest/doc/hg_lib/index.html"
license: "MIT"
x-maintenance-intent: ["(latest)"]
build: [
  ["dune" "build" "-p" name "-j" jobs]
]
depends: [
  "ocaml" {>= "5.5.0"}
  "async" {>= "v0.18~" & < "v0.19~"}
  "async_unix" {>= "v0.18~" & < "v0.19~"}
  "core" {>= "v0.18~" & < "v0.19~"}
  "core_kernel" {>= "v0.18~" & < "v0.19~"}
  "core_unix" {>= "v0.18~" & < "v0.19~"}
  "expect_test_helpers_core" {>= "v0.18~" & < "v0.19~"}
  "ppx_jane" {>= "v0.18~" & < "v0.19~"}
  "dune" {>= "3.17.0"}
]
available: arch != "x86_32"
synopsis: "A library that wraps the Mercurial command line interface"
description: "
A library that wraps the Mercurial command line interface.
"
